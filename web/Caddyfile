:8080 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy server:8000
    }

    handle /health* {
        reverse_proxy server:8000
    }

    handle /openapi.json {
        reverse_proxy server:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }
}
