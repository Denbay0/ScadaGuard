{
  "agent": {
    "agent_id": "empils-scada-primary",
    "site_id": "empils",
    "host_id": "empils-scada-primary",
    "poll_interval_seconds": 30,
    "check_timeout_seconds": 10,
    "scheduler_worker_count": 2
  },
  "logging": {
    "directory": "C:\\ProgramData\\ScadaGuard\\logs",
    "level": "info",
    "format": "text",
    "max_file_size_mb": 20,
