# Copy to deploy/.env and replace both placeholder values before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SCADAGUARD_DATABASE_URL=postgresql+asyncpg://scadaguard:replace-with-the-same-url-safe-password@postgres:5432/scadaguard
SCADAGUARD_SECRET_KEY=replace-with-at-least-32-random-characters
SCADAGUARD_PUBLIC_URL=https://scada.micom.su
SCADAGUARD_COOKIE_SECURE=true
SCADAGUARD_LOG_LEVEL=INFO
SCADAGUARD_DEFAULT_OFFLINE_THRESHOLD_SECONDS=90
SCADAGUARD_HTTP_PORT=8320
SCADAGUARD_API_PORT=8000
SCADAGUARD_POSTGRES_PORT=55432
SCADAGUARD_VERSION=0.1.0
SCADAGUARD_BUILD=production
SCADAGUARD_OPENAPI_ENABLED=false
# SCADAGUARD_MATTERMOST_WEBHOOK_URL=
